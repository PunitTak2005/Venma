# ── Server ────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ── Database ───────────────────────────────────────
# Paste your MongoDB Atlas SRV connection string here
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/venma?retryWrites=true&w=majority
# MONGODB_URI is also accepted for Render/Atlas deployments.

# ── JWT ────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d

# ── CORS ───────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
CLIENT_URL=https://venma.vercel.app

# ── Stripe (optional) ──────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# ── Cloudinary (optional) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
